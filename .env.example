# Copie este arquivo para .env.local e preencha. Depois reinicie o `npm run dev`.
# Supabase → Project Settings → API Keys (ou "Connect" no topo do painel)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave pública: a nova "publishable" (sb_publishable_...) OU a antiga "anon". Use uma das duas.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Só no servidor (Vercel). Chave "secret" (sb_secret_...) ou "service_role". Nunca exponha no navegador.
SUPABASE_SERVICE_ROLE_KEY=
# URL pública do site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Mostra a opção de login por link no e-mail. Só ligue depois de configurar SMTP próprio (domínio verificado).
# NEXT_PUBLIC_MAGIC_LINK=true
# Mostra o botão de login com Facebook. Só ligue depois de ativar o provedor no Supabase (README, passo 7).
# NEXT_PUBLIC_FACEBOOK_LOGIN=true
